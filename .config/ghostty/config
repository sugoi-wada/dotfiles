# Quick Terminal（オーバーレイ全画面表示）
# Ctrl+I で呼び出し/隠す
keybind = global:ctrl+i=toggle_quick_terminal

# 画面全体を覆うオーバーレイとして表示
quick-terminal-position = center
quick-terminal-size = 100%,100%

# 起動アニメーション時間（秒）。0で無効化
quick-terminal-animation-duration = 0

# 半透明（iTerm2の実プロファイル値: Transparency 31% ≒ opacity 0.69）
background-opacity = 0.69

# 通常ウィンドウを作らず、Quick Terminal(フローティング1枚)のみにする
initial-window = false
macos-hidden = always

# Cmd+Qでの誤終了防止（常に確認ダイアログを出す）
confirm-close-surface = always
